{
  "name": "ehr-gigi-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-3d.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "node scripts/sync-3d.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "sync-3d": "node scripts/sync-3d.mjs",
    "dev:all": "bash ../dev.sh"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
