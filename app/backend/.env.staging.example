# Templat env STAGING (Hostinger / Laravel Cloud / Forge / Docker). DATA PALSU SAJA (D-030): jangan pernah isi data pasien asli.
# Tanpa rahasia: semua nilai kosong diisi di panel penyedia (Environment variables), bukan di repo.
# Lokal pakai .env.example. Panduan: docs/deploy/staging.md, Hostinger: docs/deploy/hostinger.md
APP_NAME="EHR Gigi"
APP_ENV=staging
# php artisan key:generate --show (atau tombol "Generate" di Laravel Cloud)
APP_KEY=
APP_DEBUG=false
# Satu origin untuk SPA + API (cookie Sanctum first-party), contoh: https://staging.example.com atau https://<app>.laravel.cloud
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Docker/Laravel Cloud: stderr (dibaca platform). Hostinger (hosting bersama, tanpa akses stderr): daily
# (storage/logs/laravel-YYYY-MM-DD.log, disimpan 14 hari; tidak bisa diakses dari web). Jangan log isi data sensitif.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
# Runtime: ehr_app (tanpa DROP/TRUNCATE/ALTER; hak per tabel dari migrasi database/migrations/mysql).
DB_USERNAME=ehr_app
DB_PASSWORD=
# Host bagian akun runtime yang diberi GRANT oleh migrasi. Docker/Cloud: % (koneksi dari IP lain).
DB_APP_GRANT_HOST=%
# Migrasi/seed: ehr_admin (ALL + GRANT OPTION pada database ini).
DB_ADMIN_USERNAME=ehr_admin
DB_ADMIN_PASSWORD=
# Hostinger (satu akun DB, tidak bisa GRANT): DB_APP_GRANTS=false dan kosongkan DB_ADMIN_USERNAME + DB_ADMIN_PASSWORD
# (mysql_admin = akun yang sama). Pemisahan hak hilang; trigger append-only tetap dibuat. Hanya staging, DEVIATIONS #59.
DB_APP_GRANTS=true

# Kunci enkripsi kolom (BUKAN APP_KEY) dan kunci HMAC blind index, 32 byte. Buat masing-masing:
#   php -r 'echo "base64:", base64_encode(random_bytes(32)), PHP_EOL;'
# Jangan ganti setelah ada data: data lama tidak bisa dibaca lagi.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Contoh (same origin): SANCTUM_STATEFUL_DOMAINS=staging.example.com  FRONTEND_ORIGINS=https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=
FRONTEND_ORIGINS=

# HTTPS: redirect HTTP->HTTPS + URL https (default aktif untuk staging/production).
FORCE_HTTPS=true
# Load balancer di depan app. "*" hanya jika app tidak bisa diakses langsung selain lewat proxy (Laravel Cloud, nginx compose).
TRUSTED_PROXIES=*

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Sesi disimpan di tabel global tanpa data klinik (docs/architecture.md); enkripsi sesi tetap dinyalakan di staging.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Jangan sync di staging: butuh worker (Laravel Cloud: queue terkelola; Docker: service queue; Forge: daemon queue:work).
QUEUE_CONNECTION=database
# Hosting tanpa worker panjang (Hostinger): true = queue:work --stop-when-empty tiap menit lewat scheduler (cukup satu cron schedule:run).
QUEUE_VIA_SCHEDULER=false
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kredensial akun demo untuk `php artisan staging:seed` (wajib saat APP_ENV=staging; tidak pernah dicetak).
# Buat di komputer sendiri, simpan di pengelola sandi, jangan commit:
#   kata sandi (min. 16 karakter):        openssl rand -base64 24
#   TOTP secret (base32 A-Z/2-7, >= 16):  head -c 20 /dev/urandom | base32
# Keduanya TIDAK boleh sama dengan nilai dev publik di DatabaseSeeder.
STAGING_DEMO_PASSWORD=
STAGING_DEMO_TOTP_SECRET=

# DEV ONLY, tetap mati: POST /dev/quick-login hanya ada saat APP_ENV=local. Jangan set true di staging.
DEV_QUICK_LOGIN=false

# SATUSEHAT: sandbox saja di staging. https://satusehat.kemkes.go.id/platform/docs/id/api-code/access-sandbox/
SATUSEHAT_ENV=sandbox
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=
