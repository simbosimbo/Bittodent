{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitto.local/odontogram/legend.schema.json",
  "title": "Bitto odontogram legend.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "title", "conditions", "statuses", "states", "layering"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of this legend document, emitted by generate.py."
    },
    "title": { "type": "string", "minLength": 1 },
    "official": { "type": "boolean" },
    "disclaimer": { "type": "string" },
    "contrast": { "type": "object" },
    "surfaces": { "type": "object" },
    "baseline": { "type": "object" },
    "states": {
      "type": "object",
      "required": ["draft", "signed"],
      "properties": {
        "empty": { "type": "object" },
        "draft": {
          "type": "object",
          "required": ["color", "wash"],
          "properties": {
            "attr": { "type": "string" },
            "look": { "type": "string" },
            "badge": { "type": "string" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "wash": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "signed": {
          "type": "object",
          "required": ["color"],
          "properties": {
            "attr": { "type": "string" },
            "look": { "type": "string" },
            "badge": { "type": "string" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "color", "glyph", "mark"],
        "description": "Every condition requires a color plus a glyph/shape (glyph path and mark name).",
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "glyph": { "type": "string", "minLength": 1, "description": "Path to the glyph asset, e.g. legend/karies.svg" },
          "mark": { "type": "string", "minLength": 1, "description": "Shape name: check, dots, solid, ring, x, root-v, slash, screw, …" },
          "applies-to": { "type": "string", "enum": ["surface", "whole-tooth"] },
          "contrastVsWhite": { "type": "number" }
        }
      }
    },
    "layering": {
      "type": "object",
      "required": ["note", "layer", "opacity", "planned", "hides"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 },
        "opacity": { "type": "string", "minLength": 1 },
        "planned": { "type": "string", "minLength": 1 },
        "hides": { "type": "string", "minLength": 1 },
        "supernumerary": { "type": "string" }
      }
    },
    "statuses": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "note": { "type": "string" },
        "attr": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "color", "marker"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "visual": { "type": "string" },
              "marker": { "type": "string", "minLength": 1 },
              "outline": { "type": "string" },
              "fill-opacity": { "type": "number" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        }
      }
    }
  }
}
